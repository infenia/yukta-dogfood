{
  "claudeWorkflow": "agent",
  "checkBudget": 5,
  "giveUp": {
    "minAttempts": 5,
    "maxFixRate": 0.1,
    "days": 7
  },
  "efforts": {
    "low": {
      "timeoutSeconds": 600,
      "budget": 0.5
    },
    "medium": {
      "timeoutSeconds": 1200,
      "budget": 1
    },
    "high": {
      "timeoutSeconds": 1800,
      "budget": 2
    }
  },
  "singleAttempt": ["reuse", "docs", "actionlint"],
  "extra": {
    "docs": {
      "modules": ["docs"],
      "variants": [
        {
          "tool": "mint",
          "command": ["sh", "-c", "cd docs && mint broken-links"]
        }
      ]
    },
    "reuse": {
      "variants": [
        {
          "tool": "reuse",
          "command": ["reuse", "lint"]
        }
      ],
      "auto": "bun @HERE@/src/heal/fix-reuse.ts"
    },
    "actionlint": {
      "variants": [
        {
          "tool": "actionlint",
          "command": ["actionlint"]
        },
        {
          "tool": "docker",
          "command": [
            "sh",
            "-c",
            "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667"
          ]
        }
      ]
    }
  },
  "ladder": ["haiku/low", "haiku/medium", "haiku/high", "sonnet/low", "sonnet/medium", "sonnet/high"]
}
